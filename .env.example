# Connection used by both the loader and the dashboard.
#
# Use the Supabase POOLER HOSTNAME, never one of the IPs behind it. The pooler
# resolves to several addresses (ap-southeast-2 currently answers on two), and a
# connection string pinned to one of them fails with "No route to host" the
# moment that node is rotated or briefly unreachable - while the other is fine.
# The hostname fails over on its own; an IP cannot.
#
# Port 6543 is the transaction pooler and is what the app should use. The change
# listener needs a session, so it derives port 5432 from this value by itself -
# do not set LISTEN_DATABASE_URL unless you know you need something different.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional. When set, every /api/crm/* request must carry it as
#   X-API-Key: <value>      or      Authorization: Bearer <value>
# Leave unset for a loopback-only dev server; set it before exposing the app.
# AGENT_API_KEY=

# Optional. When set, every POST /mcp request must carry it as
#   Authorization: Bearer <value>
# This is the token the Perfox "Dashboard Insights" agent's MCP Integration
# is registered with in Perfox Studio - not the same secret as AGENT_API_KEY.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# PERFOX_MCP_TOKEN=

# Required for the "Calls the agent handled" panel. Perfox issues this from
# their console; it lists every call the agent has taken and mints playback
# URLs for the recordings.
#
# Set it in the deployment environment, never here and never in a commit.
# This repository is public, and the key reads every customer conversation the
# dealership has ever had - names, numbers and full transcripts. Anything
# pushed to a public repo is scraped within minutes.
#
# On Render: Dashboard > the service > Environment > Add Environment Variable,
# the same place DATABASE_URL already lives.
#
# Without it the panel says so and the rest of the sheet is unaffected.
# PERFOX_API_KEY=sk_...

# Optional. 0.0.0.0 listens on every interface, which a container platform
# needs; the default 127.0.0.1 accepts only local connections.
# HOST=0.0.0.0
